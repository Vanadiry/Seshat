{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Seshat Desktop",
  "version": "0.3.0",
  "identifier": "com.vanadiry.seshat",
  "build": {
    "frontendDist": "../web",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Seshat",
        "url": "http://127.0.0.1:12500",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
