{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Seshat",
    "version": "2.0.0-dev.11",
    "identifier": "com.vanadiry.seshat",
    "build": {
        "frontendDist": "../web-dist",
        "beforeBuildCommand": "pnpm run build"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "externalBin": ["../build/seshat_server"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "minimumSystemVersion": "13.0",
            "signingIdentity": "-"
        },
        "windows": {
            "nsis": {
                "languages": ["SimpChinese", "English"]
            }
        },
        "longDescription": "离线优先的 Bangumi 数据管理与浏览工具。",
        "android": {
            "debugApplicationIdSuffix": ".debug"
        }
    }
}
